NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Apache Polaris Iceberg catalog. Local development defaults.
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=s3cr3t
POLARIS_CATALOG_NAME=catalog
POLARIS_HTTP_PORT=8181
POLARIS_MGMT_PORT=8182
POLARIS_UI_PORT=8080
# One PostgreSQL 18.6 server. Databases: POLARIS, catalog, marquez, sales.
POSTGRES_PORT=5432
POLARIS_DB_USER=postgres
POLARIS_DB_PASSWORD=postgres
POLARIS_DB_NAME=POLARIS

# MinIO warehouse for Iceberg table files.
MINIO_ROOT_USER=polaris_root
MINIO_ROOT_PASSWORD=polaris_pass
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WAREHOUSE_BUCKET=warehouse
AWS_REGION=us-west-2

# Catalog explorer published by Compose.
CATALOG_API_PORT=8090
CATALOG_UI_PORT=5173
CATALOG_FLOWER_PORT=5555
# Spark SQL HTTP service. Host API uses http://127.0.0.1:8091.
SPARK_SQL_PORT=8091

# Application catalog database on the shared PostgreSQL server.
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_NAME=catalog

# Non-Iceberg source scanned by Trino. Database on the shared PostgreSQL server.
SOURCE_DB_USER=sales
SOURCE_DB_PASSWORD=sales
SOURCE_DB_NAME=sales
TRINO_PORT=8088

# Table-agent language model. provider: claude, openai, or ollama.
# Claude and OpenAI require CATALOG_LLM__API_KEY.
# Empty base URL uses the provider host. Local models still use
# CATALOG_LLM__LOCAL__BASE_URL (host.docker.internal:11434 in Compose).
# effort is copied onto a new space, scope, table, or Airflow configuration.
CATALOG_LLM__PROVIDER=openai
CATALOG_LLM__MODEL=gpt-4.1
CATALOG_LLM__EFFORT=low
CATALOG_LLM__API_KEY=
CATALOG_LLM__BASE_URL=
# OpenAI key for entities set to GPT. Also used when provider is openai.
CATALOG_LLM__GPT__API_KEY=
# Compose points local models at host Ollama. Override only for a different Ollama host.
# CATALOG_LLM__LOCAL__BASE_URL=http://host.docker.internal:11434

# OpenObserve logs and agent traces. UI http://localhost:5080.
# The password must not contain #. dotenv treats that character as a comment.
# OpenObserve also requires upper case, a digit, and a special character.
OPENOBSERVE_PORT=5080
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=Local-observe-1

# OpenLineage / Marquez. Image 0.51.1 hardcodes database marquez, user marquez, password marquez.
OPENLINEAGE_NAMESPACE=catalog
MARQUEZ_API_PORT=5050
MARQUEZ_ADMIN_PORT=5051
MARQUEZ_WEB_PORT=3000
